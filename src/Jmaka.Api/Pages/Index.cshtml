@page
@{
    Layout = null;
}
<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Jmaka</title>
  <link rel="stylesheet" href="~/app.css" asp-append-version="true" />
  <link rel="stylesheet" href="~/features/videoedit/style.css" asp-append-version="true" />
</head>
<body>
  <main id="mainContent" class="page" role="main">
    <section class="uploader" aria-label="File upload area" data-i18n-aria-label="File upload area">
      <!-- Left Panel -->
      <div class="left-panel">
        <!-- Logo at the top -->
        <div class="ascii-logo-container">
          <pre id="asciiArt" class="ascii-art"></pre>
          <span class="version-badge" data-version>v0.5.3</span>
        </div>

        <!-- Upload button and languages HORIZONTALLY -->
        <div class="upload-and-language">
          <!-- Upload button on the left -->
          <button class="save-btn" id="saveBtn" type="button" aria-label="Upload image" data-i18n-aria-label="Upload image">
            <div class="save-icon" aria-hidden="true">
              <svg class="save-arrow" viewBox="0 0 64 64" focusable="false">
                <path d="M32 8v22" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" />
                <path d="M20 24l12 12 12-12" fill="none" stroke="currentColor" stroke-width="6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <svg class="save-disk" viewBox="0 0 64 64" focusable="false">
                <path d="M10 8h34l10 10v38H10V8zm6 6v12h26V14H16zm0 20v16h32V34H16zm6-16h12v6H22v-6z" />
              </svg>
            </div>
            <div class="save-label" data-i18n="Upload image">Upload image</div>
          </button>

          <!-- Language switcher on the right -->
          <div id="languageSwitcher" class="language-switcher" role="group" aria-label="Language selector">
            <button id="langRuBtn" class="lang-btn" type="button" data-lang="ru" aria-pressed="false">Русский</button>
            <button id="langEnBtn" class="lang-btn" type="button" data-lang="en-US" aria-pressed="false">English</button>
            <button id="langEsBtn" class="lang-btn" type="button" data-lang="es-ES" aria-pressed="false">Español</button>
          </div>
        </div>
      </div>

      <!-- Right Panel -->
      <div class="preview-wrap">
        <div class="main-controls" aria-label="Control panel" data-i18n-aria-label="Control panel">
          <div class="tool-buttons" aria-label="Tools" data-i18n-aria-label="Tools">
            <div class="tool-row">
              <button id="splitToolBtn" class="btn tool-btn" type="button">Split</button>
              <button id="split3ToolBtn" class="btn tool-btn" type="button">Split3</button>
              <button id="oknoFixToolBtn" class="btn tool-btn" type="button">OknoFix</button>
              <button id="oknoScaleToolBtn" class="btn tool-btn" type="button">OknoScale</button>
            </div>
            <div class="tool-row">
              <button id="cropToolBtn" class="btn tool-btn" type="button">Crop</button>
              <button id="imageEditToolBtn" class="btn tool-btn" type="button">Edit</button>
              <button id="videoEditToolBtn" class="btn tool-btn video-edit" type="button">Video Edit<span class="excl" aria-hidden="true">❗</span></button>
            </div>
          </div>

          <div id="sizeButtons" class="size-buttons" role="group" aria-label="Sizes" data-i18n-aria-label="Sizes">
            <button class="size-btn" type="button" data-w="2440" disabled>2440</button>
            <button class="size-btn" type="button" data-w="1920" disabled>1920</button>
            <button class="size-btn" type="button" data-w="1280" disabled>1280</button>
          </div>
        </div>

        <div id="hint" class="hint" role="status" aria-live="polite" data-i18n="Click the disk icon, drag files, or paste from clipboard — they will upload automatically.">Click the disk icon, drag files, or paste from clipboard — they will upload automatically.</div>
        <button id="helpBtn" class="help-btn" type="button" aria-label="Help" data-i18n-aria-label="Help">?</button>
      </div>

      <input id="fileInput" class="file-input" type="file" accept="image/*" multiple />
      <input id="videoInput" class="file-input" type="file" accept="video/*" hidden />
    </section>

    <div class="tables-wrap" aria-label="Files tables" data-i18n-aria-label="Files tables">
      <div class="links-wrap" aria-label="Files table" data-i18n-aria-label="Files table">
        <div class="links-title">Original / Crop / Sizes</div>
        <div class="table-wrap">
          <table class="files-table" aria-label="Ready files" data-i18n-aria-label="Ready files">
            <thead>
              <tr>
                <th class="col-dt" data-i18n="Date - time">Date - time</th>
                <th class="col-orig" data-i18n="Original">Original</th>
                <th class="col-crop">Crop</th>
                <th class="col-size">1280</th>
                <th class="col-size">1920</th>
                <th class="col-size">2440</th>
                <th class="col-del"></th>
              </tr>
            </thead>
            <tbody id="filesTbody"></tbody>
          </table>
        </div>
      </div>

      <div class="links-wrap composites-wrap" aria-label="Split table" data-i18n-aria-label="Split table">
      <div class="links-title">Split / Split3 / OknoFix / OknoScale / Edits</div>
        <div class="table-wrap">
          <table class="files-table" aria-label="Split / Split3">
            <thead>
              <tr>
                <th class="col-dt" data-i18n="Date - time">Date - time</th>
                <th class="col-kind" data-i18n="Type">Type</th>
                <th class="col-comp" data-i18n="Result">Result</th>
                <th class="col-del"></th>
              </tr>
            </thead>
            <tbody id="compositesTbody"></tbody>
          </table>
        </div>
      </div>
    </div>

    <pre id="result" class="result" role="status" aria-live="polite" aria-label="Result" data-i18n-aria-label="Result" hidden></pre>
    
    <footer style="text-align: center; padding: 10px; font-size: 11px; color: #64748b; opacity: 0.7;">
      Jmaka v<span data-version>0.5.3</span>
    </footer>
  </main>

  <!-- Модалка подтверждения удаления -->
  <div id="deleteModal" class="modal" hidden>
    <div class="modal-backdrop" data-close="1"></div>
    <div class="modal-card" role="dialog" aria-modal="true" aria-label="Delete" data-i18n-aria-label="Delete">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-title" data-i18n="Delete">Delete</div>
          <div class="modal-sub">
            <span class="modal-subtext" data-i18n="Delete this entry and all related files permanently?">Delete this entry and all related files permanently?</span>
          </div>
        </div>
        <button id="deleteClose" class="modal-x" type="button" aria-label="Close" data-i18n-aria-label="Close">×</button>
      </div>
      <div class="modal-body">
        <label class="checkbox-row">
          <input id="deleteSkipConfirm" type="checkbox" />
          <span data-i18n="Do not ask again (delete immediately)">Do not ask again (delete immediately)</span>
        </label>
      </div>
      <div class="modal-footer">
        <div class="modal-hint" data-i18n="You can enable this again by clearing the LocalStorage setting.">You can enable this again by clearing the LocalStorage setting.</div>
        <div class="modal-actions">
          <button id="deleteCancel" class="btn" type="button" data-i18n="Cancel">Cancel</button>
          <button id="deleteConfirm" class="btn danger" type="button" data-i18n="Delete">Delete</button>
        </div>
      </div>
    </div>
  </div>

  <!-- Просмотр изображения -->
  <div id="viewerModal" class="modal" hidden>
    <div class="modal-backdrop" data-close="1"></div>
    <div class="modal-card viewer-card" role="dialog" aria-modal="true" aria-label="Image viewer" data-i18n-aria-label="Image viewer">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-title" data-i18n="Viewer">Viewer</div>
          <div class="modal-sub">
            <span id="viewerLabel" class="modal-subtext"></span>
            <a id="viewerOpen" class="modal-sublink" href="#" target="_blank" rel="noreferrer" hidden data-i18n="Open in new tab">Open in new tab</a>
          </div>
        </div>
        <button id="viewerClose" class="modal-x" type="button" aria-label="Close" data-i18n-aria-label="Close">×</button>
      </div>
      <div class="modal-body viewer-body">
        <img id="viewerImg" class="viewer-img" alt="" />
      </div>
    </div>
  </div>

  <partial name="Features/_SplitModal" />
  <partial name="Features/_OknoFixModal" />
  <partial name="Features/_OknoScaleModal" />
  <partial name="Features/_ImageEditModal" />
  <partial name="Features/_VideoEditModal" />
  <partial name="Features/_Split3Modal" />
  <partial name="Features/_CropModal" />
  <div id="helpModal" class="modal" hidden>
    <div class="modal-backdrop" data-close="1"></div>
    <div class="modal-card help-card" role="dialog" aria-modal="true" aria-label="Jmaka Help" data-i18n-aria-label="Jmaka Help">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div class="modal-title" data-i18n="Jmaka Help">Jmaka Help</div>
          <div class="modal-sub">
            <span class="modal-subtext" data-i18n="Practical cheat sheet for features, statuses and quick actions.">Practical cheat sheet for features, statuses and quick actions.</span>
          </div>
        </div>
        <button id="helpClose" class="modal-x" type="button" aria-label="Close" data-i18n-aria-label="Close">×</button>
      </div>
      <div class="modal-body help-body">
        <div class="help-intro">
          <p class="help-lead"><strong>Jmaka</strong> <span data-i18n="— a practical tool for quickly preparing images and video in one place.">— a practical tool for quickly preparing images and video in one place.</span></p>
          <div class="help-chip-row">
            <span class="help-chip">RU / EN / ES</span>
            <span class="help-chip" data-i18n="Images + video">Images + video</span>
            <span class="help-chip" data-i18n="History + auto-cleanup">History + auto-cleanup</span>
          </div>
        </div>

        <div class="help-grid">
          <section class="help-section">
            <h3 data-i18n="Quick start">Quick start</h3>
            <ul>
              <li data-i18n="Press the disk button, drag files, or paste an image from clipboard (Ctrl+V).">Press the disk button, drag files, or paste an image from clipboard (Ctrl+V).</li>
              <li data-i18n="Choose language in the top-right corner: Russian, English, or Spanish.">Choose language in the top-right corner: Russian, English, or Spanish.</li>
              <li data-i18n="Clicking a table row makes it active for all tools.">Clicking a table row makes it active for all tools.</li>
            </ul>
          </section>

          <section class="help-section">
            <h3 data-i18n="Files and tables">Files and tables</h3>
            <ul>
              <li data-i18n="Left: Original / Crop / sizes 1280, 1920, 2440.">Left: Original / Crop / sizes 1280, 1920, 2440.</li>
              <li data-i18n="Right: Split, Split3, OknoFix, OknoScale, Edit, and Video Edit history.">Right: Split, Split3, OknoFix, OknoScale, Edit, and Video Edit history.</li>
              <li data-i18n="Any result can be opened, downloaded, or deleted.">Any result can be opened, downloaded, or deleted.</li>
            </ul>
          </section>

          <section class="help-section">
            <h3 data-i18n="Image tools">Image tools</h3>
            <ul>
              <li><strong>Crop</strong> <span data-i18n="— crop original image (1:1, 2:3, 16:9).">— crop original image (1:1, 2:3, 16:9).</span></li>
              <li><strong>Split / Split3</strong> <span data-i18n="— compose 2 or 3 images into 1280×720 with white dividers.">— compose 2 or 3 images into 1280×720 with white dividers.</span></li>
              <li><strong>OknoFix / OknoScale</strong> <span data-i18n="— vertical cards with positioning and scale by template.">— vertical cards with positioning and scale by template.</span></li>
              <li><strong>Edit</strong> <span data-i18n="— fine tuning of color, light, detail and effects, saved as a new file.">— fine tuning of color, light, detail and effects, saved as a new file.</span></li>
            </ul>
          </section>

          <section class="help-section">
            <h3>Video Edit</h3>
            <ul>
              <li data-i18n="Trim with multiple segments, Crop, Rotate, Flip, Speed, Mute and Reset.">Trim with multiple segments, Crop, Rotate, Flip, Speed, Mute and Reset.</li>
              <li data-i18n="Merge multiple originals into one result: add clips with the '+' button at the end of timeline.">Merge multiple originals into one result: add clips with the '+' button at the end of timeline.</li>
              <li data-i18n="Each clip can have its own segments and vertical offset in preview.">Each clip can have its own segments and vertical offset in preview.</li>
              <li data-i18n="Vertical position is stored separately for Vidcov and Episod modes (10/20/30 MB).">Vertical position is stored separately for Vidcov and Episod modes (10/20/30 MB).</li>
              <li data-i18n="Overlay Upload: upload PNG/WebP/JPEG template over video.">Overlay Upload: upload PNG/WebP/JPEG template over video.</li>
              <li data-i18n="Vidcov mode and quick size limit selection (Episod 10/20/30 MB).">Vidcov mode and quick size limit selection (Episod 10/20/30 MB).</li>
              <li data-i18n="Processing statuses show queue, progress and remaining time.">Processing statuses show queue, progress and remaining time.</li>
            </ul>
          </section>

          <section class="help-section help-section-wide">
            <h3 data-i18n="Useful details">Useful details</h3>
            <ul>
              <li data-i18n="Old records and files are cleaned automatically by retention period.">Old records and files are cleaned automatically by retention period.</li>
              <li data-i18n="If processing has just finished, press Refresh in Video Edit or refresh results list.">If processing has just finished, press Refresh in Video Edit or refresh results list.</li>
              <li data-i18n="Delete button removes the record and related files permanently.">Delete button removes the record and related files permanently.</li>
            </ul>
          </section>
        </div>
      </div>
    </div>
  </div>

  <!-- Load ascii-art.js before feature scripts since shared/core depends on window.getRandomAsciiArt -->
  <script src="~/ascii-art.js" asp-append-version="true"></script>
  <script src="~/features/shared/core.js" asp-append-version="true"></script>
  <script src="~/features/split/tool.js" asp-append-version="true"></script>
  <script src="~/features/split3/tool.js" asp-append-version="true"></script>
  <script src="~/features/oknofix/tool.js" asp-append-version="true"></script>
  <script src="~/features/oknoscale/tool.js" asp-append-version="true"></script>
  <script src="~/features/crop/tool.js" asp-append-version="true"></script>
  <script src="~/features/edit/tool.js" asp-append-version="true"></script>
  <script src="~/features/videoedit/tool.js" asp-append-version="true"></script>
</body>
</html>
