  <!-- OknoFix / OknoFix -->
  <div id="oknoFixModal" class="modal" hidden>
    <div class="modal-backdrop" data-close="1"></div>
    <div class="modal-card okno-modal-card" role="dialog" aria-modal="true" aria-labelledby="oknoFixModalTitle" aria-describedby="oknoFixHint">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div id="oknoFixModalTitle" class="modal-title" data-i18n="OknoFix (1 изображение → вертикальная карточка)">OknoFix (1 изображение → вертикальная карточка)</div>
          <div class="modal-sub">
            <span class="modal-subtext" data-i18n="Окно и рамка фиксированы по шаблону. Двигайте и масштабируйте картинку под окном.">Окно и рамка фиксированы по шаблону. Двигайте и масштабируйте картинку под окном.</span>
          </div>
        </div>
        <button id="oknoFixClose" class="modal-x" type="button" aria-label="Close" data-i18n-aria-label="Close">×</button>
      </div>
      <div class="modal-body">
        <div class="okno-stage-wrap">
          <div id="oknoFixStage" class="okno-stage" aria-label="OknoFix template" data-i18n-aria-label="OknoFix template">
            <div id="oknoFixCard" class="okno-card">
              <div id="oknoFixImgViewport" class="okno-img-viewport">
                <img id="oknoFixImg" class="okno-img" alt="" />
              </div>
              <!-- PNG-шаблон всегда поверх картинки, чтобы превью совпадало с итоговым видом -->
              <div class="oknofix-overlay" aria-hidden="true"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <div id="oknoFixHint" class="modal-hint" data-i18n="Выберите строку в таблице файлов, затем откройте OknoFix.">Выберите строку в таблице файлов, затем откройте OknoFix.</div>
        <div class="modal-actions">
          <div class="okno-zoom-controls" aria-label="Background image zoom" data-i18n-aria-label="Background image zoom">
            <button id="oknoFixZoomOut" class="btn okno-zoom-btn" type="button" aria-label="Zoom out" data-i18n-aria-label="Zoom out">−</button>
            <button id="oknoFixZoomIn" class="btn okno-zoom-btn" type="button" aria-label="Zoom in" data-i18n-aria-label="Zoom in">+</button>
          </div>
          <button id="oknoFixCancel" class="btn" type="button" data-i18n="Close">Close</button>
          <button id="oknoFixApply" class="btn primary" type="button" disabled data-i18n="Process">Process</button>
        </div>
      </div>
    </div>
  </div>
