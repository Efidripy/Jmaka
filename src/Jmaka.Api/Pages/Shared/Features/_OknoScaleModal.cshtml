  <!-- OknoScale -->
  <div id="oknoScaleModal" class="modal" hidden>
    <div class="modal-backdrop" data-close="1"></div>
    <div class="modal-card okno-modal-card" role="dialog" aria-modal="true" aria-labelledby="oknoScaleModalTitle" aria-describedby="oknoScaleHint">
      <div class="modal-header">
        <div class="modal-title-wrap">
          <div id="oknoScaleModalTitle" class="modal-title" data-i18n="OknoScale (1 изображение → вертикальная карточка)">OknoScale (1 изображение → вертикальная карточка)</div>
          <div class="modal-sub">
            <span class="modal-subtext" data-i18n="Окно фиксировано по высоте и центрировано, ширину можно менять симметрично от центра.">Окно фиксировано по высоте и центрировано, ширину можно менять симметрично от центра.</span>
          </div>
        </div>
        <button id="oknoScaleClose" class="modal-x" type="button" aria-label="Close" data-i18n-aria-label="Close">×</button>
      </div>
      <div class="modal-body">
        <div class="okno-stage-wrap">
          <div id="oknoScaleStage" class="okno-stage" aria-label="OknoScale template" data-i18n-aria-label="OknoScale template">
            <div id="oknoScaleCard" class="okno-card">
              <div id="oknoScaleImgViewport" class="okno-img-viewport">
                <img id="oknoScaleImg" class="okno-img" alt="" />
              </div>
              <div id="oknoScaleHandleLeft" class="oknoscale-handle left" data-side="left"></div>
              <div id="oknoScaleHandleRight" class="oknoscale-handle right" data-side="right"></div>
            </div>
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <div id="oknoScaleHint" class="modal-hint" data-i18n="Выберите строку в таблице файлов, затем откройте OknoScale.">Выберите строку в таблице файлов, затем откройте OknoScale.</div>
        <div class="modal-actions">
          <div class="okno-zoom-controls" aria-label="Background image zoom" data-i18n-aria-label="Background image zoom">
            <button id="oknoScaleZoomOut" class="btn okno-zoom-btn" type="button" aria-label="Zoom out" data-i18n-aria-label="Zoom out">−</button>
            <button id="oknoScaleZoomIn" class="btn okno-zoom-btn" type="button" aria-label="Zoom in" data-i18n-aria-label="Zoom in">+</button>
          </div>
          <button id="oknoScaleCancel" class="btn" type="button" data-i18n="Close">Close</button>
          <button id="oknoScaleApply" class="btn primary" type="button" disabled data-i18n="Process">Process</button>
        </div>
      </div>
    </div>
  </div>

